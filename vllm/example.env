# vllm compose configuration.
# Copy this file to .env (same folder) and edit. Per node you set MODEL (+ LoRA).
# The path keys (MODELS_DIR/LORA_DIR) are FIXED - they point at the .temp view
# isannd assembles from the store; do not edit them.

# ---- Profile metadata (set by broker UI when applying a profile) ------------
# Applying a profile from the broker UI refreshes PROFILE_NAME and
# PROFILE_APPLIED_AT automatically. If you edited this .env by hand instead,
# leaving PROFILE_NAME as "custom" is fine.
PROFILE_NAME=default
PROFILE_APPLIED_AT=

# ---- Image -------------------------------------------------------------------
IMAGE_NAME=vllm/vllm-openai
IMAGE_TAG=latest
CONTAINER_NAME=vllm

# ---- Network -----------------------------------------------------------------
# Localhost-only debug port - compose binds it to 127.0.0.1, NOT exposed to the
# network. Container internal port is fixed at 8080 (unified across engines;
# the provider dials this host port to reach the engine).
PORT=7864

# Static IP on the `isann` docker network (10.10.1.0/24). Convention:
#   10.10.1.11   sd
#   10.10.1.12   vllm  (this one)
#   10.10.1.13   llama
#   10.10.1.201  rendezvous
IP=10.10.1.12

# vllm's multi-process attention kernels exchange tensors through shared memory.
# The default /dev/shm of 64m segfaults under a real workload; 4g covers most LLMs.
SHM_SIZE=4g

# ---- Storage -----------------------------------------------------------------
# FIXED path key - points at the .temp view isannd assembles (by hardlink) from
# the canonical store (artifacts/addon/models/vllm/) on `docker prepare vllm` /
# `docker start vllm -prepare`. Same on Windows+WSL / Linux / macOS.
# Do NOT edit MODELS_DIR - set MODEL below.
MODELS_DIR=./.temp/models/defaults

# Model directory (HuggingFace checkpoint format). The in-view name is the store
# folder name (the checkpoint lives in store/vllm/defaults/<MODEL>/),
# e.g. qwen2.5-1.5b. Inside the container it appears as /models/<MODEL>.
MODEL=qwen2.5-1.5b

# Model name the OpenAI API advertises. Usually the same as MODEL.
# Empty = use MODEL.
SERVED_MODEL_NAME=

# ---- vllm runtime knobs ------------------------------------------------------
# Max context length. vllm errors out if it exceeds the model's capability.
MAX_MODEL_LEN=16384

# Share of GPU VRAM to claim (0.0 - 1.0). 0.75 = take 75% and leave the rest for
# other processes or models.
GPU_MEMORY_UTILIZATION=0.75

# Concurrent sequences = concurrent inferences. Lower means steadier latency and
# lower throughput. The provider's queue worker count follows this value
# automatically (manifest concurrency_env) - concurrency is tuned here and
# nowhere else.
MAX_NUM_SEQS=1

# ---- LoRA --------------------------------------------------------------------
# LORA_DIR - FIXED view path, mounted at /loras. isannd assembles ALL of
# store/vllm/loras/ here; vllm LoRAs are PEFT adapter DIRECTORIES, so each is
# preserved as a folder /loras/<store-dir-name>/ (adapter_config.json + weights
# travel together). The dir always exists (even empty). To enable them you need
# ENABLE_LORA="1" plus LORA_MODULES.
LORA_DIR=./.temp/models/loras

# LORA_MODULES - the LoRA modules to register with vllm at container start.
# Format: "name=/loras/<store-dir-name>" (space separated, vllm's own
# --lora-modules form). <store-dir-name> is the folder under store/vllm/loras/
# (preserved as a folder in the view). A client selects one by passing that name
# in the OpenAI API's model field.
# Example: LORA_MODULES="myadapter=/loras/myadapter another=/loras/another-v2"
LORA_MODULES=

# How many LoRAs may be loaded at once.
MAX_LORAS=1

# Upper bound on LoRA rank - at least the r value used during training.
MAX_LORA_RANK=16

# ---- Optional flags ----------------------------------------------------------
# For quantization: awq / gptq / squeezellm / fp8 / ...
# Empty = unquantized (the model as-is).
QUANTIZATION=

# Skip CUDA Graph compilation - faster startup and less memory, slightly slower
# inference. Off: empty. On: a truthy value such as "1".
ENFORCE_EAGER=

# dtype override, e.g. bfloat16, float16, float32. Empty = auto.
DTYPE=

# KV cache dtype, e.g. fp8, fp8_e4m3, fp8_e5m2. Empty = follow the model dtype.
KV_CACHE_DTYPE=

# Tensor parallelism - the GPU count when using multiple GPUs.
# Empty or 1 = single GPU.
TENSOR_PARALLEL_SIZE=

# ---- Catch-all ---------------------------------------------------------------
# Any extra vllm flags, appended verbatim.
# Example: EXTRA_VLLM_ARGS=--swap-space 4 --disable-log-stats
EXTRA_VLLM_ARGS=

# ---- Tool calling ------------------------------------------------------------
# TOOL_CALLS - on | empty (off). Turn it on for any node that runs agents.
#
# With it off, vLLM returns the model's raw text and the caller has to guess the
# tool call. Small models break the argument JSON often (escaping the structural
# quotes, for one), and the agent run stops right there.
TOOL_CALLS=on

# TOOL_PARSER - REQUIRED when TOOL_CALLS=on; run.sh refuses to start without it.
# Model families emit tool calls in different shapes, so vLLM has to be told
# which parser to use (this is why it is not a single switch the way llama.cpp's
# --jinja is).
#
# The value below matches the MODEL shipped above (qwen2.5-1.5b): Qwen2.5 emits
# Hermes-style tool calls. CHANGE IT WHEN YOU CHANGE MODEL - a parser meant for
# another family will not match what the model writes.
#   qwen2.5 / qwen3          hermes
#   llama 3.1 / 3.2          llama3_json
#   mistral                  mistral
# To see what the installed vLLM supports:
#   docker run --rm vllm/vllm-openai --help | grep -A5 tool-call-parser
# A wrong name fails startup - better than failing silently.
TOOL_PARSER=hermes

# TOOL_CALL_TEMPLATE - optional. Point it at a separate template only when the
# model's own chat template cannot handle tool calls. Usually left empty.
TOOL_CALL_TEMPLATE=
