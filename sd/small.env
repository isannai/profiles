# small — Stable Diffusion 1.5 at 512x512. The 4GB-class default.
#
# SD keeps models per ARCHITECTURE, so two fields have to agree with the pull:
#     model pull … --engine sd --kind model --arch sd15 --name v1-5-pruned-emaonly
#       ARCH  ─────────────────────────────────────┘
#       MODEL ────────────────────────────────────────────────┘ plus the file
#
# Changing ARCH swaps the entire assembled view to that architecture's tree, so
# an SDXL checkpoint under ARCH=sd15 is simply never mounted.
PROFILE_NAME=small
PROFILE_APPLIED_AT=
IMAGE_NAME=ghcr.io/isannai/sd
IMAGE_TAG=latest
CONTAINER_NAME=sd
PORT=7860
IP=10.10.1.11
MODELS_DIR=./.temp/models/defaults
ARCH=sd15
MODEL=v1-5-pruned-emaonly/v1-5-pruned-emaonly.safetensors
OUTPUTS_DIR=./outputs
VAE_DIR=./.temp/models/vaes
VAE_FILE=
LORA_DIR=./.temp/models/loras
# sd.cpp applies these to EVERY request - they are not per-request overrides.
# 20 steps at CFG 7 is the usual 1.5 starting point.
STEPS=20
CFG_SCALE=7
SAMPLE_METHOD=
THREADS=
VAE_ON_CPU=
CLIP_ON_CPU=
EXTRA_SD_ARGS=
