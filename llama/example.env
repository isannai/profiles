# llama compose configuration.
# Copy this file to .env (same folder) and edit. Per node you set MODEL (+ LoRA).
# The path keys (MODELS_DIR/LORA_DIR) are FIXED - they point at the .temp view
# isannd assembles from the store; do not edit them.

# ---- Profile metadata (set by broker UI when applying a profile) ------------
# Applying a profile from the broker UI refreshes PROFILE_NAME and
# PROFILE_APPLIED_AT automatically. If you edited this .env by hand instead,
# leaving PROFILE_NAME as "custom" is fine.
PROFILE_NAME=default
PROFILE_APPLIED_AT=

# ---- Image -------------------------------------------------------------------
IMAGE_NAME=ghcr.io/isannai/llama
IMAGE_TAG=latest
CONTAINER_NAME=llama

# ---- Network -----------------------------------------------------------------
# Localhost-only debug port - compose binds it to 127.0.0.1, NOT exposed to the
# network. Container internal port is fixed at 8080 (unified across engines;
# the provider dials this host port to reach the engine).
PORT=7862

# Static IP on the `isann` docker network (10.10.1.0/24). Convention:
#   10.10.1.11   sd
#   10.10.1.12   vllm
#   10.10.1.13   llama  (this one)
#   10.10.1.201  rendezvous
IP=10.10.1.13

# ---- Storage -----------------------------------------------------------------
# FIXED path key - points at the .temp view isannd assembles (by hardlink) from
# the canonical store (artifacts/addon/models/llama/) on `docker prepare llama` /
# `docker start llama -prepare`. Same on Windows+WSL / Linux / macOS.
# Do NOT edit MODELS_DIR - set MODEL below.
MODELS_DIR=./.temp/models/defaults

# Model file (a single gguf). In-view path <store-dir-name>/<file>, relative to
# MODELS_DIR (checkpoints live under store/llama/defaults/<store-dir-name>/).
# Inside the container it appears as /models/<MODEL>.
MODEL=Qwen2.5-1.5B-Q4_K_M/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf

# Model name the OpenAI API advertises. Empty = llama-server decides.
SERVED_MODEL_NAME=

# ---- llama-server runtime knobs ----------------------------------------------
# Context window (--ctx-size, -c). Total context shared by all slots
# (per slot = CTX_SIZE/PARALLEL). Beyond the model's capability some models
# apply RoPE scaling automatically.
CTX_SIZE=8192

# Layers to offload to the GPU (--n-gpu-layers, -ngl). 99 = all. 0 = CPU only.
# Lower it to save memory.
GPU_LAYERS=99

# Multi-GPU split mode (--split-mode, -sm). Ignored on a single GPU.
# none | layer | row | tensor.
#   layer  = split layers+KV across GPUs (default, pipelined, spreads VRAM)
#   row    = split weights by row (parallelized, higher throughput; KV/main on -mg GPU)
#   none   = use one GPU only (which one: -mg)
#   tensor = split weights+KV (parallelized, EXPERIMENTAL)
# Empty = llama-server default (layer).
# GPU ratio (-ts) and main GPU (-mg) go in EXTRA_LLAMA_ARGS:
#   EXTRA_LLAMA_ARGS="--tensor-split 3,1 --main-gpu 0"
SPLIT_MODE=

# Concurrent slots = concurrent inferences (--parallel, -np). Default 1.
# Per-slot context = CTX_SIZE/PARALLEL. The provider's queue worker count
# follows this value automatically (manifest concurrency_env) - concurrency is
# tuned here and nowhere else.
PARALLEL=1

# /slots monitoring endpoint (--slots / --no-slots). on | off.
# Empty = llama default (enabled).
# WARNING: when on, GET /slots exposes each slot's prompt and state - prefer off
# on a node reachable from outside.
SLOTS=

# CPU threads (--threads, -t). Empty = llama-server decides (by logical cores).
THREADS=

# KV cache quantization. Empty = f16 (default, recommended).
# Quantized types such as q8_0 need flash attention for V-cache quantization, so
# run.sh adds --flash-attn on automatically (the GPU must support FA).
# q4_0 loses too much quality - on small models the output can degrade to noise -
# so it is not recommended. If VRAM is tight, try q8_0 first.
KV_TYPE=

# Tool calling (--jinja). on | empty (off).
#
# Turn this on for any node that runs agents. With it off the server scrapes tool
# calls out of the model's free-form output after the fact, and small models get
# that wrong often - they escape the structural quotes so every later key is
# swallowed into one string (isannd then reports only "cmd is missing" while the
# model repeats the same call), or they start emitting an id and burn the token
# budget on hex. With it on, generation is constrained by the model's chat
# template, so a malformed call cannot be produced in the first place.
#
# Default on - agents are barely useful without it, so turning it OFF is the
# deliberate choice.
#
# WARNING: the model's chat template must have a tool section. If the template in
# the gguf metadata is poor, set CHAT_TEMPLATE below explicitly. If startup
# fails, clear this first to check whether it is the cause.
TOOL_CALLS=on

# Chat template - set it to match the model (chatml / llama3 / qwen / gemma / ...).
# Empty = auto-detected from the model's chat_template metadata.
CHAT_TEMPLATE=

# Disable mmap and load normally - for NFS or Windows mounts where mmap breaks.
# Empty = use mmap (the recommended default).
NO_MMAP=

# mlock - lock the model into RAM to prevent swapping. Needs root or a raised
# ulimit.
MLOCK=

# ---- LoRA --------------------------------------------------------------------
# LORA_DIR - FIXED view path, mounted at /loras. isannd assembles ALL of
# store/llama/loras/ here as flat <name>.gguf (the dir always exists, even
# empty). What actually gets loaded is decided by LORA_ADAPTERS - empty means no
# LoRA at all.
LORA_DIR=./.temp/models/loras

# LORA_ADAPTERS - LoRA adapters to load (space separated, relative to /loras).
# The flat name is the store folder name + .gguf, e.g. anime.gguf
# (= store/llama/loras/anime/).
# Plain form (scale=1.0):
#   LORA_ADAPTERS="anime.gguf detail.gguf"
# With an explicit scale:
#   LORA_ADAPTERS="anime.gguf=0.8 detail.gguf=1.2"
# The two forms can be mixed. llama.cpp supports loading several LoRAs at once.
LORA_ADAPTERS=

# ---- Catch-all ---------------------------------------------------------------
# Any extra llama-server flags, appended verbatim.
# Example: EXTRA_LLAMA_ARGS=--flash-attn --no-context-shift
EXTRA_LLAMA_ARGS=
