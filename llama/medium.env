# medium — Qwen2.5 14B Q4_K_M. Wants a 12GB+ card.
#
# Pairs with:
#     model pull … --engine llama --kind model --name Qwen2.5-14B-Q4_K_M
#
# 🔴 The model and this file travel together. Applying this profile without the
# 14B weights on disk leaves the engine pointing at a directory that is not
# there; pulling the weights without applying this profile leaves 9GB unused
# while the small model keeps serving. llama-large.ian does both, in that order.
PROFILE_NAME=medium
PROFILE_APPLIED_AT=
IMAGE_NAME=ghcr.io/isannai/llama
IMAGE_TAG=latest
CONTAINER_NAME=llama
PORT=7862
IP=10.10.1.13
MODELS_DIR=./.temp/models/defaults
MODEL=Qwen2.5-14B-Q4_K_M/Qwen2.5-14B-Instruct-Q4_K_M.gguf
SERVED_MODEL_NAME=
# 8192 rather than the model's full window: at Q4_K_M the weights already take
# ~9GB, and the KV cache grows with context. A larger window on a 12GB card
# spills to host memory, which reads as "the node got slow" rather than an
# out-of-memory error.
CTX_SIZE=8192
GPU_LAYERS=99
SPLIT_MODE=
PARALLEL=1
SLOTS=
THREADS=
KV_TYPE=
TOOL_CALLS=on
CHAT_TEMPLATE=
NO_MMAP=
MLOCK=
LORA_DIR=./.temp/models/loras
LORA_ADAPTERS=
EXTRA_LLAMA_ARGS=
