# small — Qwen2.5 1.5B Q4_K_M. The 4GB-class default.
#
# MODEL names a DIRECTORY under the assembled view plus the file inside it, so
# it has to match what `model pull --name` created, character for character:
#     model pull … --engine llama --kind model --name Qwen2.5-1.5B-Q4_K_M
# A mismatch starts the container and loads nothing.
PROFILE_NAME=small
PROFILE_APPLIED_AT=
IMAGE_NAME=ghcr.io/isannai/llama
IMAGE_TAG=latest
CONTAINER_NAME=llama
PORT=7862
IP=10.10.1.13
MODELS_DIR=./.temp/models/defaults
MODEL=Qwen2.5-1.5B-Q4_K_M/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
SERVED_MODEL_NAME=
CTX_SIZE=8192
# 99 = put every layer on the GPU. 1.5B at Q4_K_M is ~1.1GB of weights, so a
# 4GB card holds the whole model and the KV cache with room to spare.
GPU_LAYERS=99
SPLIT_MODE=
PARALLEL=1
SLOTS=
THREADS=
KV_TYPE=
TOOL_CALLS=on
CHAT_TEMPLATE=
NO_MMAP=
MLOCK=
LORA_DIR=./.temp/models/loras
LORA_ADAPTERS=
EXTRA_LLAMA_ARGS=
