# vit-base-patch32 - CLIP ViT-B/32 on CPU. The one most nodes want.
#
# clip does not generate anything. It scores how well an image and a piece of
# text agree, which is what the faucet's image track uses to grade a prober's
# answer. One model, no size variants, no GPU.
#
# MODEL has to match the folder the pull created:
#     model pull https://huggingface.co/openai/clip-vit-base-patch32 \
#       --engine clip --kind model --name clip-vit-base-patch32
#       MODEL ────────────────────────────────────────┘
#
# A mismatch here means the container starts and then cannot find the weights.

# ---- Profile metadata (set by broker UI when applying a profile) ------------
PROFILE_NAME=vit-base-patch32
PROFILE_APPLIED_AT=

# ---- Image -------------------------------------------------------------------
# Built locally from src/, hence no registry prefix - this is never pulled.
IMAGE_NAME=isannai/clip
IMAGE_TAG=local
CONTAINER_NAME=clip

# ---- Network -----------------------------------------------------------------
PORT=7866
IP=10.10.1.14

# ---- Storage -----------------------------------------------------------------
# FIXED path key - the .temp view isannd assembles from the store. Do not edit.
MODELS_DIR=./.temp/models/defaults
MODEL=clip-vit-base-patch32

# ---- Validation --------------------------------------------------------------
# Both ride along on every verdict as model / version. Changing the model shifts
# the score distribution, so past verdicts stop being comparable - bump
# VALIDATOR_VERSION whenever you do.
CLIP_MODEL=openai/clip-vit-base-patch32
VALIDATOR_VERSION=1.0.0

# Threshold for mode 1 (absolute similarity) only. Mode 2 (element-wise
# contrast) is tuned by the request's `margin` and ignores this.
CLIP_THRESHOLD=0.25

# waitress worker threads. Single process - each worker adds about 840MB, so
# drop this to 2 on a memory-tight node.
THREADS=4
